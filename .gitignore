# ── Virtual Environment ────────────────────────────────────────────────────────
venv/
env/
.venv/

# ── Python Cache ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# ── Model Weights (too large for GitHub — share via Google Drive or Git LFS) ───
*.pth
*.pt
*.ckpt

# ── Dataset (too large for GitHub) ────────────────────────────────────────────
data/

# ── Generated Output (created at runtime, not source code) ────────────────────
outputs/results/*
outputs/flags/*
outputs/demo_report.csv
!outputs/results/.gitkeep
!outputs/flags/.gitkeep

# ── Uploaded Images (user content, not source code) ───────────────────────────
static/uploads/*
!static/uploads/.gitkeep

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/moderation_log.json
!logs/.gitkeep

# ── API Keys and Secrets ───────────────────────────────────────────────────────
.env
.env.local
secrets.json

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── macOS ──────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble

# ── Windows ────────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
ehthumbs.db
